    "control.openPit.description" : {
      "comment" : "Control gallery description for Open Pit",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens PitStop straight to Pit, ready to remember something about your car."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу открывает запись в PitStop, чтобы запомнить что-то о машине."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одразу відкриває запис у PitStop, щоб запам'ятати щось про машину."
          }
        }
      }
    },
