{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Config/Analytics.xcconfig" },
    { "name": "Release", "file": "Config/Analytics.xcconfig" },
  ],
  "localizations": {
    "development": "ru",
    "supported": [
      "Base",
      "en",
      "uk",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "Pitstop",
      "target-membership": [
        "Pitstop",
      ],
      "membership-exceptions": [
        {
          "target": "Pitstop",
          "exclusions": [
            "Pitstop.entitlements.example",
          ],
        },
        {
          "target": "PitstopWidgets",
          "exclusions": [
            "Domain/Capture/DomainCommandLimits.swift",
            "Domain/Maintenance/Maintenance.swift",
            "Domain/Maintenance/MaintenanceEngine.swift",
            "Domain/Maintenance/VehicleServiceReport.swift",
            "Domain/Vehicle/ProvisionalCarContext.swift",
            "Domain/Vehicle/Vehicle.swift",
            "Infrastructure/Persistence/NextServiceStoreReader.swift",
            "Infrastructure/Persistence/PersistenceContainer.swift",
            "Infrastructure/Persistence/PitstopSchemaV1.swift",
            "Infrastructure/Persistence/PitstopSchemaV2.swift",
            "Infrastructure/Persistence/PitstopSchemaV3.swift",
            "Infrastructure/Persistence/PitstopSchemaV4.swift",
            "Infrastructure/Persistence/RecordMapping.swift",
            "Infrastructure/Persistence/StoreLocation.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "PitstopTests", "target-membership": [ "PitstopTests" ] },
    {
      "kind": "folder",
      "path": "PitstopWidgets",
      "target-membership": [
        "PitstopWidgets",
      ],
      "membership-exceptions": [
        {
          "target": "PitstopWidgets",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    {
      "kind": "folder",
      "path": "Shared",
      "target-membership": [
        "Pitstop",
        "PitstopWidgets",
      ],
    },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Analytics.xcconfig" },
        { "path": "Info.plist" },
        { "path": "Pitstop.entitlements" },
        { "path": "PitstopWidgets.entitlements" },
      ],
    },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Pitstop.app", "id": "A1000000000000000000010E", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/PitstopTests.xctest", "id": "A1000000000000000000010F", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/PitstopWidgets.appex", "id": "A10000000000000000000110", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Pitstop/copy/Embed App Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Pitstop",
      "id": "A10000000000000000000401",
      "product": "Products/Pitstop.app",
      "product-type": "application",
      "dependencies": [
        "PitstopWidgets",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed App Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Config/Pitstop.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDevelopmentRegion": "ru",
        "INFOPLIST_KEY_CFBundleDisplayName": "PitStop",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_UILaunchStoryboardName": "LaunchScreen",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "MARKETING_VERSION": "1.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.vil4max.pitstop",
        "PRODUCT_NAME": "Pitstop",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "PitstopTests",
      "id": "A10000000000000000000402",
      "product": "Products/PitstopTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Pitstop",
      "dependencies": [
        "Pitstop",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.vil4max.pitstop.tests",
        "PRODUCT_NAME": "PitstopTests",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_VERSION": "6.0",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Pitstop.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Pitstop",
      },
    }, {
      "name": "PitstopWidgets",
      "id": "A10000000000000000000403",
      "product": "Products/PitstopWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Config/PitstopWidgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "PitstopWidgets/Info.plist",
        "INFOPLIST_KEY_CFBundleDevelopmentRegion": "ru",
        "INFOPLIST_KEY_CFBundleDisplayName": "PitStop",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "MARKETING_VERSION": "1.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.vil4max.pitstop.widgets",
        "PRODUCT_NAME": "PitstopWidgets",
        "SKIP_INSTALL": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "BTHRDS7254",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_DYNAMIC_NO_PIC": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL": "s",
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "MTL_ENABLE_DEBUG_INFO": "NO",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL": "-O",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "26.0",
}
