    },
    "detail.seasonal.value.winter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winter tires in %lld days"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
