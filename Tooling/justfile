# Arguments pass through as "$@": interpolating them into the script re-splits a
# quoted launch argument, and -note "changed the oil" reached the app as "changed".
[positional-arguments]
run-sim *args:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ justfile_directory() }}"
    for d in "$root/Tooling/scripts" "$root/scripts"; do
      if [[ -x "$d/run-sim.sh" ]]; then exec "$d/build-slot.sh" run "$d/run-sim.sh" "$@"; fi
    done
    echo "run-sim.sh not found under $root" >&2
    exit 1

