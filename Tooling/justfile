# Machine-wide Xcode build slots shared by every app and worktree (BUILD_SLOTS, default 2):
# `just build-slot status`; `acquire <label> [minutes]` prints a token for `release <token>` (Xcode MCP work).
[positional-arguments]
build-slot *args:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ justfile_directory() }}"
    for d in "$root/Tooling/scripts" "$root/scripts"; do
      if [[ -x "$d/build-slot.sh" ]]; then exec "$d/build-slot.sh" "$@"; fi
    done
    echo "build-slot.sh not found under $root" >&2
    exit 1

# Deletes this app's leftover test clones (shut-down "Clone N of <device>"); other apps are untouched.
sim-clean:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ justfile_directory() }}"
    for d in "$root/Tooling/scripts" "$root/scripts"; do
      if [[ -x "$d/sim-clean.sh" ]]; then exec "$d/sim-clean.sh"; fi
    done
    echo "sim-clean.sh not found under $root" >&2
    exit 1

# Checks the app against the shared iOS baseline; `--strict` also fails on warnings (docs/ci.md, "Baseline").
[positional-arguments]
baseline *args:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ justfile_directory() }}"
    runtime="${IOS_AGENT_RUNTIME_ROOT:-$HOME/Developer/Personal/agent-tools/ios-agent-toolchain}"
    for d in "$root/Tooling/scripts" "$root/scripts"; do
      if [[ -f "$d/baseline.py" ]]; then
        if [[ -d "$runtime/scripts" ]]; then exec python3 "$d/baseline.py" "$root" --runtime "$runtime" "$@"; fi
        exec python3 "$d/baseline.py" "$root" "$@"
      fi
    done
    echo "baseline.py not found under $root" >&2
    exit 1
