set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Runtime public API — lives under Tooling/.
# Prefer Tooling/scripts when this justfile is imported from the app root.
# Fall back to ./scripts when invoked as `just -f Tooling/justfile`.

doctor *args:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{ justfile_directory() }}"
    for d in "$root/Tooling/scripts" "$root/scripts"; do
      if [[ -x "$d/doctor.sh" ]]; then exec "$d/doctor.sh" {{args}}; fi
    done
    echo "doctor.sh not found under $root" >&2
    exit 1

